# Local defaults and Coolify production variables.
# Never commit the real values. Add these in Coolify as environment variables.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret

# Coolify production
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False

# Comma-separated domains. Include the Coolify domain and your custom domain.
ALLOWED_HOSTS=your-app.example.com

# Comma-separated HTTPS origins, including the scheme.
CSRF_TRUSTED_ORIGINS=https://your-app.example.com

# Persistent Coolify volume mounted at /data.
# Copy the local db.sqlite3 to /data/db.sqlite3 and local media/ to /data/media/.
DATABASE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media

# Recreated during deploy by collectstatic; it does not contain uploaded media.
STATIC_ROOT=/data/staticfiles